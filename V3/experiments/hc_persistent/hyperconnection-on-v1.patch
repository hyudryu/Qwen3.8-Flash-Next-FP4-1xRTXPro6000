+    def _v3_fused_mix(self, normalized: torch.Tensor, api):
+        """V3: whole small-row TP1 mix (down+inject, scaled SiLU, up, gated mean) in one launch."""
+        if (api is None or not _V3_HC_FUSED or normalized.shape[0] > 4
+                or self.hc_count != 4 or self.lora_rank != 320 or self.hidden_size != 2560
+                or normalized.dtype != torch.bfloat16 or not normalized.is_contiguous()):
+            return None
+        down_layer = (self.input_mix_weight_down_block_inject if self.use_combine
+                      else self.input_mix_weight_down)
+        wd, wu = down_layer.weight, self.input_mix_weight_up.weight
+        if not (wd.is_contiguous() and wu.is_contiguous()) or wd.shape[0] > 2 * _V3_HC_CTAS:
+            return None
+        from kernels.hc_v3 import hc_mix_persistent
+        tokens, width = normalized.shape[0], wd.shape[0]
+        down, counter = self.workspace.v3_down, self.workspace.v3_counter
+        # One shared down buffer is safe: each combine consumes the previous
+        # injection in stream order before the next mix overwrites it.
+        down = down[: tokens * width].view(tokens, width)
+        bottleneck = self.workspace.bottleneck[:tokens]
+        block_input = self.workspace.block_input[:tokens]
+        hc_mix_persistent[(_V3_HC_CTAS,)](
+            normalized, wd, wu, down, bottleneck, block_input, counter, tokens,
+            4 * 2560, width, 320, 4, 2560, _V3_HC_CTAS, 2048, 16, num_warps=8)
+        injection = down[:, 320:324] if self.use_combine else None
+        return block_input, injection
+
     def _mix_sharded(self, normalized: torch.Tensor):
