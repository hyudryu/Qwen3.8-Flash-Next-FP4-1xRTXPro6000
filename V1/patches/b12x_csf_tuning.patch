+    geometries = tuple((*g[:7], config.groups_per_task,
+                        int(config.shared_exceptions), *g[7:])
+                       for g in (query.first, query.second))
+    optimized = pipeline_geometries(*geometries) if 64 <= query.routes < 16 * query.first[6] else None
+    with torch.cuda.device(ordinal):
+        pipeline = (() if optimized is None else tuple(
+            compile_pipeline(*optimized, ids64) for ids64 in (False, True)))
+        if pipeline and query.routes <= 512:
+            from kernels.csf_routes import compact_experts
+            # Match the production ABI without allocating tensors or launching.
+            # Retain this Triton executable alongside the two CUDA decode ABIs.
+            compact = compact_experts.warmup(
+                getattr(torch, query.ids_dtype), torch.int32,
+                query.routes, 512, 512, grid=(1,), num_warps=8)
+            pipeline = (*pipeline, compact)
+    return programs, routing, pipeline
