+# --- V3 dynamic draft vocabulary -------------------------------------------
+# Static top-K draft head + a ring of request-context tokens (prompt and accepted
+# tokens seen by the MTP) scored against the target BF16 head. slot_of[token]:
+# -3 static, -1 absent, -2 being claimed, -4 evicted while claimed, >=0 ring slot.
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _dyn_observe_kernel(ids, n, slot_of, ring, cursor, full, rows, vocab,
+                        D: tl.constexpr, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    tok = tl.load(ids + offs, mask=m, other=0).to(tl.int32)
+    m = m & (tok >= 0) & (tok < vocab)
+    state = tl.load(slot_of + tok, mask=m, other=0)
+    m = m & (state == -1)
+    tok = tl.where(m, tok, 0)  # masked lanes address a valid entry and never match -7
+    neg2 = tl.full(tok.shape, -2, tl.int32)
+    won = tl.atomic_cas(slot_of + tok, tl.where(m, -1, -7).to(tl.int32), neg2) == -1
+    m = m & won
+    pos = (tl.atomic_add(cursor + tl.zeros_like(offs), tl.where(m, 1, 0).to(tl.int64), mask=m) % D).to(tl.int32)
+    prev = tl.atomic_xchg(ring + pos, tok, mask=m)
+    ev = m & (prev >= 0)
+    prev_safe = tl.where(ev, prev, 0)
+    neg1 = tl.full(tok.shape, -1, tl.int32)
+    # A ring position can be reused within one launch (> D new tokens), so the evicted token may
+    # not have published its slot yet (-2). Mark it -4 and let its owner release it to -1.
+    old = tl.atomic_cas(slot_of + prev_safe, tl.where(ev, pos, -7).to(tl.int32), neg1)
+    pend = ev & (old == -2)
+    old = tl.atomic_cas(slot_of + prev_safe, tl.where(pend, -2, -7).to(tl.int32), tl.full(tok.shape, -4, tl.int32))
+    late = pend & (old == pos)  # owner published between the two CAS
+    tl.atomic_cas(slot_of + prev_safe, tl.where(late, pos, -7).to(tl.int32), neg1)
+    lost = m & (tl.atomic_cas(slot_of + tok, tl.where(m, -2, -7).to(tl.int32), pos) == -4)
+    tl.atomic_cas(slot_of + tok, tl.where(lost, -4, -7).to(tl.int32), neg1)
+    for r in range(rows):  # evicted token column back to -inf
+        tl.store(full + r * vocab + prev_safe, float("-inf"), mask=ev)
+
+
+@triton.jit
+def _dyn_logits_kernel(h, w, ring, full, T, vocab, H: tl.constexpr, BD: tl.constexpr, BK: tl.constexpr):
+    j = tl.program_id(0) * BD + tl.arange(0, BD)
+    tok = tl.load(ring + j)
+    valid = tok >= 0
+    safe = tl.where(valid, tok, 0).to(tl.int64)
+    t = tl.program_id(1) * 16 + tl.arange(0, 16)
+    acc = tl.zeros((16, BD), tl.float32)
+    for kb in tl.static_range(0, H, BK):
+        k = kb + tl.arange(0, BK)
+        a = tl.load(h + t[:, None] * H + k[None, :], mask=t[:, None] < T, other=0.)
+        b = tl.load(w + safe[None, :] * H + k[:, None], mask=valid[None, :], other=0.)
+        acc = tl.dot(a, b, acc)
+    tl.store(full + t[:, None] * vocab + safe[None, :], acc.to(full.dtype.element_ty),
+             mask=(t[:, None] < T) & valid[None, :])
+
+
+def _dyn_observe_op(ids: torch.Tensor, slot_of: torch.Tensor, ring: torch.Tensor,
+                    cursor: torch.Tensor, full: torch.Tensor) -> None:
+    n = ids.numel()
+    if n:
+        _dyn_observe_kernel[(triton.cdiv(n, 256),)](
+            ids, n, slot_of, ring, cursor, full, full.shape[0], full.shape[1],
+            D=ring.numel(), BLOCK=256)
+
+
+def _dyn_logits_op(hidden: torch.Tensor, weight: torch.Tensor, ring: torch.Tensor,
+                   full: torch.Tensor) -> None:
+    T = hidden.shape[0]
+    _dyn_logits_kernel[(ring.numel() // 16, triton.cdiv(T, 16))](
+        hidden, weight, ring, full, T, full.shape[1], H=hidden.shape[1], BD=16, BK=256, num_warps=4)
+
+
+def _dyn_noop(*args, **kwargs) -> None:
+    return
+
+
+direct_register_custom_op(op_name="qwen38_draft_dyn_observe", op_func=_dyn_observe_op,
+                          mutates_args=["slot_of", "ring", "cursor", "full"], fake_impl=_dyn_noop)
+direct_register_custom_op(op_name="qwen38_draft_dyn_logits", op_func=_dyn_logits_op,
+                          mutates_args=["full"], fake_impl=_dyn_noop)
+
+
