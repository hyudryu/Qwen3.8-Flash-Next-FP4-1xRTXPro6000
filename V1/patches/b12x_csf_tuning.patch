+def compile_expansion_with_pipeline(query_payload, config_payload, ordinal):
+    # A distinct compile factory retains the custom CUDA programs through
+    # discovery, worker compilation, materialization and graph capture.
+    from kernels.csf_pipeline import compile_pipeline, pipeline_geometries
+    query = CsfExpansionQuery(**dict(query_payload))
